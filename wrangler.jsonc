{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nsea-site",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "nseaswim.cloudflareaccess.com",
    "EVENTS_REPO": "jpmerchant/nsea-events",
    "EVENTS_BRANCH": "main",
    "ACCESS_AUD": "c3b6669fefd29e9f5f9a704f443f86ecc21770eba6499e054f56a6693bcaea2a"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nsea-carpool",
      "database_id": "e9529275-14ce-4778-9c80-f612ed0f33e1",
      "migrations_dir": "migrations"
    }
  ]
}
