---
import Base from '../layouts/Base.astro';
import HubGrid from '../components/HubGrid.astro';
import Thoughts from '../components/Thoughts.astro';
import { SITE, pages } from '../data/site.mjs';
import { topLevel, getPage } from '../lib/nav.mjs';
const quick = ['/programs/practice-groups/', '/about/coaching-staff/', '/meets/calendar/', '/programs/join/'].map(getPage);
const featured = ['/times/standards/check-my-time/', '/meets/calendar/', '/times/top-times/swimmers/', '/times/records/individual/'].map(getPage);
---
<Base title="NSEA Swim" description="NSEA Swim: a USA Swimming / North Carolina Swimming club in Wilmington, NC." path="/">
  <section class="hero">
    <div>
      <h1>{SITE.tagline}</h1>
      <p>NSEA Swim is a USA Swimming / North Carolina Swimming affiliated club in Wilmington, NC, committed to developing competitive swimmers while promoting diversity, discipline, and personal growth in a supportive environment.</p>
      <a class="btn solid" href="/programs/">Find your group</a> &nbsp; <a class="btn" href="/about/">Learn more</a>
    </div>
  </section>

  <div class="two">
    <div>
      <h2>Upcoming deadlines</h2>
      <iframe class="embed" src="https://events.nseaswimteam.com/widget/" title="Upcoming deadlines" style="height:420px" loading="lazy"></iframe>
    </div>
    <div>
      <h2>About NSEA Swim</h2>
      <div class="prose"><p>Northside Elite Aquatics, or NSEA Swim, is a competitive swim team offering high quality professional coaching and technique instruction for all ages and abilities. Our goal is to give each member an opportunity to improve their swimming and achieve success at their level of ability, from novice to international competitor.</p><p>NSEA Swim is a nonprofit run by its elected Board of Directors. All members are welcome at each meeting and encouraged to be involved in team activities and fundraisers.</p></div>
      <HubGrid items={quick} cta="Go" />
    </div>
  </div>

  <div class="section-title">Thought of the Month</div>
  <Thoughts mode="current" />

  <div class="section-title">Explore</div>
  <HubGrid items={topLevel} cta="Explore" />

  <div class="section-title">Popular tools</div>
  <HubGrid items={featured} cta="Open" />

  <div class="section-title">Coach&rsquo;s Corner</div>
  <div class="prose"><p>Coach&rsquo;s Corner is coming soon.</p></div>
</Base>
