---
// Single admin console. Talks to the Worker at /api/admin/*. All text is inserted with textContent.
---
<div id="ac" class="ac"><p class="cp-loading">Loading…</p></div>
<noscript><p>The admin console needs JavaScript.</p></noscript>
<script is:inline src="/assets/rich.js"></script>

<script is:inline>
(function () {
  var root = document.getElementById('ac');
  var me = null, view = 'overview', flash = '', linkBox = null;
  var ROLE_LABEL = { owner: 'Owner (everything)', carpool: 'Carpool', events: 'Events & Calendar', schedule: 'Practice Schedule', content: 'Content', assessment: 'Assessments', reports: 'Reports (coach-only results reports)', meetday: 'Meet Day (coaches’ meet app)', coach: 'Coach (own Coach’s Corner posts, Meet Day)', staff: 'Staff records (every coach’s profile and private details, approves coach changes)' };
  var MODULE_LABEL = { carpool: 'Carpool', events: 'Events & Calendar', schedule: 'Practice Schedule', content: 'Content', assessment: 'Assessments', reports: 'Reports', meetday: 'Meet Day', coach: 'Coach’s Corner', staff: 'Staff Records', profile: 'My Coach Profile', coaching: 'Meet Coaching' };

  function el(tag, attrs) {
    var n = document.createElement(tag);
    if (attrs) for (var k in attrs) {
      if (k === 'class') n.className = attrs[k];
      else if (k.slice(0, 2) === 'on') n.addEventListener(k.slice(2), attrs[k]);
      else if (attrs[k] !== false && attrs[k] != null) n.setAttribute(k, attrs[k]);
    }
    (function add(list) {
      for (var i = 0; i < list.length; i++) {
        var c = list[i];
        if (c == null || c === false) continue;
        if (Array.isArray(c)) add(c);
        else n.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);
      }
    })(Array.prototype.slice.call(arguments, 2));
    return n;
  }
  function api(method, path, body) {
    return fetch('/api/admin' + path, { method: method, credentials: 'same-origin', headers: body ? { 'content-type': 'application/json' } : {}, body: body ? JSON.stringify(body) : undefined })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { if (!r.ok) { var e = new Error(d.error || 'Something went wrong.'); e.status = r.status; throw e; } return d; }); });
  }
  function mount() { root.replaceChildren.apply(root, Array.prototype.filter.call(arguments, function (x) { return x != null; })); }
  function msg(kind, t) { return t ? el('p', { class: 'cp-msg ' + kind, role: kind === 'err' ? 'alert' : 'status' }, t) : null; }
  function date(s) { return s ? s.slice(0, 16).replace('T', ' ') : ''; }
  function btn(label, fn, cls) { return el('button', { class: 'btn small ' + (cls || ''), type: 'button', onclick: fn }, label); }
  function act(label, path, cls, after, body) {
    return btn(label, function () {
      api('POST', path, body || {}).then(function (r) {
        if (r.link) { linkBox = { name: after, link: r.link }; flash = ''; } else flash = '';
        go(view);
      }).catch(function (e) { flash = ''; alert(e.message); });
    }, cls);
  }
  function showLink() {
    if (!linkBox) return null;
    var lb = linkBox, inp = el('input', { readonly: true, value: lb.link, 'aria-label': 'Sign-in link', onfocus: function (e) { e.target.select(); } });
    return el('div', { class: 'cp-panel cp-link-box' }, el('strong', null, 'Sign-in link for ' + lb.name + ' (works once, valid 14 days):'), inp,
      btn('Copy', function () { inp.select(); if (navigator.clipboard) navigator.clipboard.writeText(lb.link); }),
      el('p', { class: 'cp-small' }, 'Send it privately. This is the only time it is shown. ', el('button', { class: 'cp-link', type: 'button', onclick: function () { linkBox = null; go(view); } }, 'Hide')));
  }

  // ---------- shell ----------
  // The console is split: coaching tools first, club administration second. A heading shows only if its section has something you can open.
  var NAV = [['overview', 'Overview'],
    ['-', 'Coaching'], ['profile', 'My Coach Profile', 'profile'], ['meetday', 'Meet Day', 'meetday'], ['coaching', 'Meet Coaching', 'coaching'], ['coach', 'Coach’s Corner', 'coach'], ['reports', 'Reports', 'reports'],
    ['-', 'Admin'], ['carpool', 'Carpool', 'carpool'], ['events', 'Events & Calendar', 'events'], ['schedule', 'Practice Schedule', 'schedule'], ['content', 'Content', 'content'], ['assessment', 'Assessments', 'assessment'],
    ['staff', 'Staff Records', 'staff'], ['admins', 'Admins', 'owner'], ['audit', 'Activity log', 'owner']];
  function allowed(n) { return n[0] === '-' || !n[2] || (n[2] === 'owner' ? me.owner : me.modules.indexOf(n[2]) >= 0); }
  function navItems() {
    var out = [], head = null;
    NAV.forEach(function (n) {
      if (n[0] === '-') { head = n; return; }
      if (!allowed(n)) return;
      if (head) { out.push(el('p', { class: 'ac-nav-h' }, head[1])); head = null; }
      out.push(el('button', { type: 'button', 'aria-current': view === n[0] ? 'page' : 'false', onclick: function () { go(n[0]); } }, n[1]));
    });
    return out;
  }
  function shell(content) {
    mount(
      el('div', { class: 'ac-top' }, el('p', null, 'Signed in as ', el('strong', null, me.name), ' (' + me.email + ')'),
        me.via === 'link' ? el('button', { class: 'cp-link', type: 'button', onclick: function () { api('POST', '/logout', {}).then(function () { me = null; boot(); }); } }, 'Sign out') : el('span', { class: 'cp-small' }, 'Cloudflare Access')),
      el('div', { class: 'ac-layout' },
        el('nav', { class: 'ac-nav', 'aria-label': 'Admin sections' }, navItems()),
        el('div', { class: 'ac-main' }, msg('ok', flash), showLink(), content)));
  }
  function go(v) { view = v; ({ overview: vOverview, carpool: vCarpool, events: vEvents, schedule: vSchedule, content: vContent, assessment: vAssessment, coach: vCoach, reports: vReports, meetday: vMeetday, coaching: vCoaching, staff: vStaff, profile: vProfile, admins: vAdmins, audit: vAudit })[v](); }
  function loading() { return el('p', { class: 'cp-empty' }, 'Loading…'); }
  function fail(box, e) { box.replaceChildren(msg('err', e.message)); }

  // ---------- overview ----------
  function vOverview() {
    var box = el('div', null, loading()); shell(box);
    api('GET', '/overview').then(function (o) {
      var cards = [];
      if (o.carpool) cards.push(el('div', { class: 'cp-panel' }, el('h3', null, 'Carpool'),
        el('p', null, el('strong', null, String(o.carpool.pending)), ' waiting for approval'),
        el('p', { class: 'cp-small' }, o.carpool.members + ' families · ' + o.carpool.openPosts + ' open posts · ' + o.carpool.matches + ' matches'),
        btn('Open Carpool', function () { go('carpool'); }, o.carpool.pending ? '' : 'ghost')));
      if (me.modules.indexOf('events') >= 0) cards.push(el('div', { class: 'cp-panel' }, el('h3', null, 'Events & Calendar'), el('p', { class: 'cp-small' }, 'Edit the 2026–27 events and venues.'), btn('Open', function () { go('events'); }, 'ghost')));
      if (me.modules.indexOf('schedule') >= 0) cards.push(el('div', { class: 'cp-panel' }, el('h3', null, 'Practice Schedule'), el('p', null, el('strong', null, String(o.schedule || 0)), ' suggested change' + (o.schedule === 1 ? '' : 's') + ' waiting'), btn('Review', function () { go('schedule'); }, o.schedule ? '' : 'ghost')));
      if (me.modules.indexOf('coaching') >= 0) cards.push(el('div', { class: 'cp-panel' }, el('h3', null, 'Meet Coaching'), el('p', { class: 'cp-small' }, 'Which meet sessions you can coach, and hotel rooms.'), btn('Open', function () { go('coaching'); }, 'ghost')));
      if (me.modules.indexOf('profile') >= 0) cards.push(el('div', { class: 'cp-panel' }, el('h3', null, 'My Coach Profile'), el('p', { class: 'cp-small' }, 'Your bio, photo, memberships and accomplishments.'), btn('Open', function () { go('profile'); }, 'ghost')));
      if (o.staff != null) cards.push(el('div', { class: 'cp-panel' }, el('h3', null, 'Staff Records'), el('p', null, el('strong', null, String(o.staff)), ' coach change' + (o.staff === 1 ? '' : 's') + ' waiting for your OK'), btn('Review', function () { staffTab = o.staff ? 'review' : 'list'; staffSel = null; go('staff'); }, o.staff ? '' : 'ghost')));
      if (o.admins != null) cards.push(el('div', { class: 'cp-panel' }, el('h3', null, 'Admins'), el('p', null, el('strong', null, String(o.admins)), ' people'), btn('Manage admins', function () { go('admins'); }, 'ghost')));
      box.replaceChildren(el('h2', null, 'Overview'), el('div', { class: 'ac-cards' }, cards),
        o.recent && o.recent.length ? el('div', { class: 'cp-panel' }, el('h3', null, 'Recent activity'), o.recent.map(logLine)) : null);
    }).catch(function (e) { fail(box, e); });
  }
  function logLine(r) { return el('p', { class: 'cp-small' }, date(r.at) + ' UTC · ' + r.admin_email + ' · ' + r.module + ': ' + r.action + (r.detail ? ' — ' + r.detail : '')); }

  // ---------- carpool ----------
  function vCarpool() {
    var box = el('div', null, loading()); shell(box);
    api('GET', '/carpool').then(function (o) {
      var pending = o.members.filter(function (m) { return m.status === 'pending'; });
      var others = o.members.filter(function (m) { return m.status !== 'pending'; });
      var openPosts = o.posts.filter(function (p) { return p.status === 'open'; });
      box.replaceChildren(el('h2', null, 'Carpool'),
        el('div', { class: 'cp-panel' }, el('h3', null, 'Waiting for approval (' + pending.length + ')'),
          el('p', { class: 'cp-small' }, 'Check each family against the roster before approving. Approving creates a one-time sign-in link to send them privately.'),
          pending.length ? pending.map(function (m) { return el('div', { class: 'cp-row' }, el('div', null, el('strong', null, m.family_name), ' · ' + m.swimmers, el('p', { class: 'cp-small' }, m.email + (m.phone ? ' · ' + m.phone : '') + ' · requested ' + date(m.created_at).slice(0, 10))),
            el('div', { class: 'cp-btns' }, act('Approve', '/carpool/members/' + m.id + '/approve', '', m.family_name), act('Reject', '/carpool/members/' + m.id + '/reject', 'ghost'))); }) : el('p', { class: 'cp-empty' }, 'No requests waiting.')),
        el('div', { class: 'cp-panel' }, el('h3', null, 'Families (' + others.length + ')'),
          others.map(function (m) { return el('div', { class: 'cp-row' }, el('div', null, el('strong', null, m.family_name), m.status === 'disabled' ? ' (disabled)' : '', ' · ' + m.swimmers, el('p', { class: 'cp-small' }, m.email)),
            el('div', { class: 'cp-btns' }, m.status === 'active' ? act('New link', '/carpool/members/' + m.id + '/link', '', m.family_name) : null,
              act(m.status === 'disabled' ? 'Re-enable' : 'Disable', '/carpool/members/' + m.id + (m.status === 'disabled' ? '/enable' : '/disable'), 'ghost'))); })),
        el('div', { class: 'cp-panel' }, el('h3', null, 'Open posts (' + openPosts.length + ')'),
          openPosts.length ? openPosts.map(function (p) { return el('div', { class: 'cp-row' }, el('div', null, el('strong', null, p.family_name), ' · ' + (p.kind === 'offer' ? 'offers' + (p.driver ? ' (' + p.driver + ' driver)' : '') : 'needs') + (p.groups ? ' · ' + p.groups.split(',').join('/') : '') + (p.swimmer ? ' · ' + p.swimmer : '') + ' · ' + p.days.split(',').join(' · ') + ' · ' + p.time_label + ' · ' + p.area, el('p', { class: 'cp-small' }, 'posted ' + date(p.created_at).slice(0, 10))),
            el('div', { class: 'cp-btns' }, act('Close', '/carpool/posts/' + p.id + '/close', 'ghost'))); }) : el('p', { class: 'cp-empty' }, 'No open posts.')),
        el('div', { class: 'cp-panel' }, el('h3', null, 'Recent connections'),
          o.connections.length ? o.connections.slice(0, 50).map(function (c) { return el('p', { class: 'cp-small' }, c.requester + ' → ' + c.poster + ' (' + c.kind + ', ' + c.area + ') · ' + c.status + ' · ' + date(c.updated_at).slice(0, 10)); }) : el('p', { class: 'cp-empty' }, 'None yet.')));
    }).catch(function (e) { fail(box, e); });
  }

  // ---------- practice schedule ----------
  var stab = 'queue';
  var KIND_LABEL = { cancel: 'No practice', time: 'Time change', replace: 'Replaced by', add: 'Added', info: 'FYI' };
  var SRC_LABEL = { meet: 'Meet', 'team-event': 'Team event', holiday: 'Holiday plan', sheet: 'Holiday sheet', school: 'School day', hs: 'HS meets', wsl: 'WSL', reminder: 'Reminder', manual: 'Added by hand' };
  var DOW = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  function sday(d) { var t = new Date(d + 'T12:00:00Z'); return DOW[t.getUTCDay()] + ' ' + (+d.slice(5, 7)) + '/' + (+d.slice(8, 10)); }
  function vSchedule() {
    var box = el('div', null, loading());
    var tabs = [['queue', 'Pending changes'], ['week', 'This week & next'], ['settings', 'Base schedule & settings']];
    shell(el('div', null, el('h2', null, 'Practice Schedule'),
      el('div', { class: 'cp-tabs' }, tabs.map(function (t) { return el('button', { type: 'button', 'aria-selected': stab === t[0] ? 'true' : 'false', 'aria-current': stab === t[0] ? 'page' : 'false', onclick: function () { stab = t[0]; vSchedule(); } }, t[1]); })),
      box));
    api('GET', '/schedule').then(function (o) { ({ queue: sQueue, week: sWeek, settings: sSettings })[stab](box, o); }).catch(function (e) { fail(box, e); });
  }
  function sPost(path, body, okMsg) {
    return api('POST', path, body || {}).then(function (r) { flash = typeof okMsg === 'function' ? okMsg(r) : okMsg; vSchedule(); }).catch(function (e) { alert(e.message); vSchedule(); });
  }
  function groupSelect(groups, val, all) {
    return el('select', { name: 'group_name' }, (all ? ['All'] : []).concat(groups).map(function (g) { return el('option', { value: g, selected: g === val }, g); }));
  }
  function addForm(o) {
    var out = el('div');
    var f = el('form', { class: 'cp-inline', onsubmit: function (e) {
      e.preventDefault();
      var b = {}; Array.prototype.forEach.call(f.elements, function (x) { if (x.name) b[x.name] = x.value; });
      api('POST', '/schedule/changes', b).then(function () { flash = 'Change added and approved. Remember to post it in Captyn.'; vSchedule(); }).catch(function (err) { out.replaceChildren(msg('err', err.message)); });
    } },
      el('label', null, 'Date', el('input', { type: 'date', name: 'date', required: true, min: o.today })),
      el('label', null, 'Group', groupSelect(o.groups, 'All', true)),
      el('label', null, 'Session', el('select', { name: 'session' }, el('option', { value: 'AM' }, 'AM'), el('option', { value: 'PM', selected: true }, 'PM'))),
      el('label', null, 'Change', el('select', { name: 'kind' }, ['cancel', 'time', 'replace', 'add'].map(function (k) { return el('option', { value: k }, KIND_LABEL[k]); }))),
      el('label', null, 'New time or label', el('input', { name: 'value', maxlength: 60, placeholder: '4:30 - 6:00  or  Rock Gym' })),
      el('label', null, 'Note for families (optional)', el('input', { name: 'note', maxlength: 140, placeholder: 'Taper week' })),
      el('label', null, 'Why (coaches only)', el('input', { name: 'reason', maxlength: 300, placeholder: 'Coach out, taper, pool closed…' })),
      el('button', { class: 'btn small', type: 'submit' }, 'Add change'));
    return el('div', null, f, out);
  }
  function chip(c) { return el('span', { class: 'chip ' + (c === 'likely' ? 'new' : c === 'maybe' ? 'pull' : '') }, c); }
  function sQueue(box, o) {
    var last = o.runs[0];
    var nextMon = o.weeks[1].start;
    var likely = o.queue.filter(function (q) { return q.confidence === 'likely' && (['cancel', 'add', 'replace'].indexOf(q.kind) >= 0 || (q.kind === 'time' && q.value)); }).length;
    var byDate = {};
    o.queue.forEach(function (q) { (byDate[q.date] = byDate[q.date] || []).push(q); });
    var list = Object.keys(byDate).sort().map(function (d) {
      return el('div', { class: 'cp-panel' }, el('h3', null, sday(d)), byDate[d].map(function (q) {
        var val = el('input', { value: q.value || '', maxlength: 60, 'aria-label': 'New time or label', placeholder: q.kind === 'time' ? 'New time, e.g. 4:30 - 6:00' : 'Label' });
        var note = el('input', { value: q.note || '', maxlength: 140, 'aria-label': 'Note for families', placeholder: 'Note for families (optional)' });
        var kind = el('select', { 'aria-label': 'Change', onchange: function () { val.hidden = kind.value === 'cancel'; } }, ['cancel', 'time', 'replace', 'add'].map(function (k) { return el('option', { value: k, selected: k === q.kind }, KIND_LABEL[k]); }));
        val.hidden = q.kind === 'cancel';
        return el('div', { class: 'cp-row' },
          el('div', null, el('strong', null, (q.group_name === 'All' ? 'All groups' : q.group_name) + (q.kind === 'info' ? '' : ' ' + q.session) + ' · ' + KIND_LABEL[q.kind] + (q.value && q.kind !== 'time' ? ' ' + q.value : '')), ' ', chip(q.confidence),
            el('p', { class: 'cp-small' }, (q.reason.indexOf(SRC_LABEL[q.source]) === 0 ? '' : (SRC_LABEL[q.source] || q.source) + ': ') + q.reason),
            q.kind === 'info' ? null : el('div', { class: 'cp-inline' }, kind, val, note)),
          el('div', { class: 'cp-btns' },
            btn(q.kind === 'info' ? 'Got it' : 'Approve', function () {
              api('POST', '/schedule/changes/' + q.id + '/approve', q.kind === 'info' ? {} : { kind: kind.value, value: val.value, note: note.value })
                .then(function () { flash = q.kind === 'info' ? '' : 'Approved. Remember to post it in Captyn.'; vSchedule(); }).catch(function (e) { alert(e.message); });
            }),
            btn(q.kind === 'info' ? 'Dismiss' : 'Reject', function () { sPost('/schedule/changes/' + q.id + '/reject', {}, ''); }, 'ghost')));
      }));
    });
    var upcoming = o.decided.filter(function (q) { return q.status === 'approved' && q.kind !== 'info' && q.date >= o.today; });
    box.replaceChildren(
      el('div', { class: 'cp-panel' },
        el('p', null, last ? 'Last check: ' + date(last.at) + ' UTC (' + (last.by === 'cron' ? 'Wednesday night' : last.by) + ') · ' + last.added + ' new · covers ' + sday(last.window_start) + ' – ' + sday(last.window_end) : 'The check has not run yet. It runs every Wednesday night.'),
        last && last.problems ? el('div', { class: 'cp-msg err' }, last.problems.split('\n').map(function (p) { return el('p', { class: 'cp-small' }, p); })) : null,
        el('div', { class: 'cp-btns' }, btn('Import the Holiday Break sheet', function (e) {
            e.target.disabled = true; e.target.textContent = 'Reading the sheet…';
            sPost('/schedule/holiday-import', {}, function (r) { return 'Holiday Break sheet: ' + r.added + ' new suggestion(s)' + (r.updated ? ', ' + r.updated + ' updated' : '') + (r.same ? ', ' + r.same + ' already approved' : '') + (r.sections.length ? ' (' + r.sections.join(', ') + ')' : '') + '. Review them below.'; });
          }, 'ghost'),
          btn('Run the check now', function (e) { e.target.disabled = true; e.target.textContent = 'Checking…'; sPost('/schedule/run', {}, function (r) { return 'Check done: ' + r.added + ' new suggestion(s)' + (r.removed ? ', ' + r.removed + ' no longer needed' : '') + '.'; }); }, 'ghost'),
          likely ? btn('Approve all ' + likely + ' “likely”', function () { if (confirm('Approve all ' + likely + ' “likely” changes? Time changes without a time stay in the list.')) sPost('/schedule/approve-likely', {}, function (r) { return r.approved + ' approved. Remember to post them in Captyn.'; }); }) : null)),
      el('div', { class: 'cp-panel' }, el('h3', null, 'Anything else for the week of ' + sday(nextMon) + '?'),
        el('p', { class: 'cp-small' }, 'Taper, coach out, pool closure, anything the calendars don’t show. Changes added here are approved straight away.'), addForm(o)),
      o.queue.length ? el('div', null, el('h3', null, 'Suggested (' + o.queue.length + ')'), list) : el('p', { class: 'cp-empty' }, 'Nothing waiting. The next check runs Wednesday night.'),
      el('div', { class: 'cp-panel' }, el('h3', null, 'Approved, coming up (' + upcoming.length + ')'),
        el('p', { class: 'cp-small' }, 'Captyn is where families look first. Tick each change once it is posted there.'),
        upcoming.length ? upcoming.map(function (q) {
          return el('div', { class: 'cp-row' },
            el('div', null, el('strong', null, sday(q.date) + ' · ' + (q.group_name === 'All' ? 'All groups' : q.group_name) + ' ' + q.session + ' · ' + KIND_LABEL[q.kind] + (q.value ? ' ' + q.value : '')),
              el('p', { class: 'cp-small' }, (SRC_LABEL[q.source] || q.source) + (q.reason ? ': ' + q.reason : '') + (q.note ? ' · Note: ' + q.note : '') + (q.decided_by ? ' · ' + q.decided_by : ''))),
            el('div', { class: 'cp-btns' },
              el('label', { class: 'inline' }, el('input', { type: 'checkbox', checked: !!q.captyn, onchange: function (e) { api('POST', '/schedule/changes/' + q.id + '/captyn', { on: e.target.checked }).catch(function (er) { alert(er.message); }); } }), ' Posted in Captyn'),
              q.source_ref ? btn('Undo', function () { sPost('/schedule/changes/' + q.id + '/reopen', {}, 'Moved back to the suggestions.'); }, 'ghost')
                : btn('Delete', function () { if (confirm('Delete this change?')) sPost('/schedule/changes/' + q.id + '/delete', {}, 'Deleted.'); }, 'ghost')));
        }) : el('p', { class: 'cp-empty' }, 'None.')));
  }
  function weekTable(w) {
    return el('div', { class: 'cp-panel' }, el('h3', null, 'Week of ' + sday(w.start) + (w.season ? ' · ' + w.season : '')),
      el('div', { class: 'table-wrap' }, el('table', { class: 'sched-table' },
        el('thead', null, el('tr', null, el('th', null, 'Group'), w.days.map(function (d) { return el('th', null, d.short); }))),
        el('tbody', null, w.rows.map(function (r) {
          return el('tr', null, el('th', { scope: 'row' }, r.group + ' ' + r.session), r.cells.map(function (c) { return el('td', { class: c.changed ? 'changed' : (c.text === 'Off' ? 'off' : '') }, c.text, c.note ? el('small', null, ' ' + c.note) : null); }));
        })))),
      el('p', { class: 'cp-small' }, 'Shaded cells are changes. Newsletter version: ', el('a', { href: '/embeds/practice-week.html?start=' + w.start, target: '_blank', rel: 'noopener' }, 'open the week table'), '.'));
  }
  function sWeek(box, o) { box.replaceChildren(el('p', { class: 'cp-small' }, 'Approved changes only. This is what families see on the website and in the newsletter.'), weekTable(o.weeks[0]), weekTable(o.weeks[1])); }
  function sSettings(box, o) {
    var cfg = JSON.parse(JSON.stringify(o.config)), c = cfg.check;
    var DAYS6 = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    var out = el('div');
    var seasonPanels = cfg.seasons.map(function (s) {
      var rows = [];
      o.groups.forEach(function (g) {
        ['AM', 'PM'].forEach(function (ss) {
          var has = s.base[g] && s.base[g][ss];
          var cb = el('input', { type: 'checkbox', checked: !!has, 'aria-label': g + ' ' + ss + ' practices this season', onchange: function (e) {
            if (e.target.checked) { s.base[g] = s.base[g] || {}; s.base[g][ss] = ['Off', 'Off', 'Off', 'Off', 'Off', 'Off']; } else if (s.base[g]) { delete s.base[g][ss]; }
            box.replaceChildren(); sSettings(box, Object.assign({}, o, { config: cfg }));
          } });
