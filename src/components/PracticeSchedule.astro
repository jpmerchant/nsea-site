---
// Practice schedule. The base schedules render at build time from src/data/schedule-defaults.mjs, then the page loads
// the live data (/api/content/schedule): this week and next with approved changes marked, and the current base schedules.
// Edited in the admin console (Practice Schedule). Captyn messages are still where changes are announced first.
// "Add to your calendar" links to the practice feed (/api/content/schedule.ics?group=…): this week + the next 4, changes applied.
import { SEASONS, SCHED_GROUPS } from '../data/schedule-defaults.mjs';
const DAYS6 = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const fmt = (d) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<div class="sched" data-sched>
  <section class="sched-feed" data-sched-feed>
    <h2>Add practices to your calendar</h2>
    <p>Subscribe once and your calendar app keeps your swimmer's practice times up to date, including approved changes, for this week and the next four. Calendar apps check for updates every few hours, so Captyn messages still have the latest.</p>
    <p class="sched-feed-pick">
      <label>Group <select data-feed-group>
        {SCHED_GROUPS.map((g) => <option value={g.toLowerCase()}>{g}</option>)}
        <option value="all">All groups</option>
      </select></label>
    </p>
    <div class="btn-row">
      <a class="btn solid" data-feed-sub href="/api/content/schedule.ics?group=splash">Subscribe (iPhone, Mac, Outlook)</a>
      <a class="btn" data-feed-google href="https://calendar.google.com/calendar/r" target="_blank" rel="noopener">Add to Google Calendar</a>
    </div>
    <p class="cp-small">Or copy this link into your calendar app's "subscribe" / "from URL" option: <code data-feed-url></code></p>
  </section>
  <section data-sched-weeks hidden>
    <h2>This week &amp; next</h2>
    <p class="sched-legend"><span>Shaded</span> times are changes from the usual schedule. Captyn messages always have the latest.</p>
    <div data-sched-weeklist></div>
  </section>
  <div data-sched-base>
    {SEASONS.map((s, si) => (
      <section class="sched-season">
        <h2>{s.label}</h2>
        <p class="cp-small">{fmt(s.start)} – {fmt(s.end)}</p>
        {s.note && <p>{s.note}</p>}
        <div class="table-wrap"><table class="sched-table">
          <thead><tr><th>Group</th>{DAYS6.map((d) => <th>{d}</th>)}</tr></thead>
          <tbody>
            {SCHED_GROUPS.flatMap((g) => ['AM', 'PM'].filter((x) => s.base[g] && s.base[g][x]).map((x, xi) => (
              <tr id={si === 0 && xi === 0 ? g.toLowerCase() : undefined}><th scope="row">{g} {x}</th>{s.base[g][x].map((t) => <td class={t === 'Off' ? 'off' : undefined}>{t}</td>)}</tr>
            )))}
          </tbody>
        </table></div>
      </section>
    ))}
  </div>
</div>
<script is:inline>
(function () {
  var root = document.querySelector('[data-sched]');
  if (!root) return;
  (function feed() {
    var sel = root.querySelector('[data-feed-group]');
    if (!sel) return;
    function set() {
      var https = location.origin + '/api/content/schedule.ics?group=' + sel.value;
      var webcal = https.replace(/^https?:/, 'webcal:');
      root.querySelector('[data-feed-sub]').href = webcal;
      root.querySelector('[data-feed-google]').href = 'https://calendar.google.com/calendar/r?cid=' + encodeURIComponent(webcal);
      root.querySelector('[data-feed-url]').textContent = https;
    }
    var m = location.hash.match(/^#(splash|tidepool|riptide|breakers|surge|senior)$/);
    if (m) sel.value = m[1];
    sel.addEventListener('change', set); set();
  })();
  var GROUPS = ['Splash', 'Tidepool', 'Riptide', 'Breakers', 'Surge', 'Senior'], DAYS6 = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  function el(tag, cls, text) { var n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; }
  function long(d) { return new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }); }
  function table(head, rows) {
    var wrap = el('div', 'table-wrap'), t = el('table', 'sched-table'), th = el('thead'), tr = el('tr');
    head.forEach(function (h) { tr.appendChild(el('th', null, h)); }); th.appendChild(tr); t.appendChild(th);
    var tb = el('tbody');
    rows.forEach(function (r) {
      var row = el('tr'), h = el('th', null, r.label); h.scope = 'row'; row.appendChild(h);
      if (r.id) row.id = r.id;
      r.cells.forEach(function (c) { var td = el('td', c.changed ? 'changed' : (c.text === 'Off' ? 'off' : ''), c.text); if (c.note) td.appendChild(el('small', null, c.note)); row.appendChild(td); });
      tb.appendChild(row);
    });
    t.appendChild(tb); wrap.appendChild(t); return wrap;
  }
  fetch('/api/content/schedule?weeks=2').then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
    if (!d) return;
    var wl = root.querySelector('[data-sched-weeklist]'); wl.replaceChildren();
    d.weeks.forEach(function (w, i) {
      if (!w.rows.length) return;
      var s = el('div', 'sched-week');
      s.appendChild(el('h3', null, (i === 0 ? 'This week' : 'Next week') + ': ' + w.days[0].short + ' – ' + w.days[6].short));
      s.appendChild(table(['Group'].concat(w.days.map(function (x) { return x.short; })), w.rows.map(function (r) { return { label: r.group + ' ' + r.session, cells: r.cells }; })));
      wl.appendChild(s);
    });
    root.querySelector('[data-sched-weeks]').hidden = !wl.children.length;
    var base = root.querySelector('[data-sched-base]'); base.replaceChildren();
    var anchored = {};
    d.seasons.filter(function (s) { return s.end >= d.today; }).forEach(function (s) {
      var sec = el('section', 'sched-season');
      sec.appendChild(el('h2', null, s.label));
      sec.appendChild(el('p', 'cp-small', long(s.start) + ' – ' + long(s.end)));
      if (s.note) sec.appendChild(el('p', null, s.note));
      var rows = [];
      GROUPS.forEach(function (g) { ['AM', 'PM'].forEach(function (x) { if (s.base[g] && s.base[g][x]) rows.push({ id: anchored[g] ? null : (anchored[g] = g.toLowerCase()), label: g + ' ' + x, cells: s.base[g][x].map(function (t) { return { text: t }; }) }); }); });
      sec.appendChild(table(['Group'].concat(DAYS6), rows));
      base.appendChild(sec);
    });
    if (location.hash) { var t = document.getElementById(location.hash.slice(1)); if (t) t.scrollIntoView(); }
  }).catch(function () {});
})();
</script>
<style>
  .sched-feed{background:#E6F3F1;border-left:5px solid var(--teal);border-radius:8px;padding:16px 20px;margin:0 0 28px}
  .sched-feed h2{margin-top:0}
  .sched-feed select{font:inherit;padding:6px 8px;margin-left:6px;border-radius:6px;border:1px solid #9BA0A3}
  .sched-feed code{word-break:break-all;font-size:12px}
  .sched .table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
</style>
