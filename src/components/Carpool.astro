---
// Carpool board UI. Talks to the Worker at /api/carpool/*. All user text is inserted with textContent.
---
<div id="cp" class="cp">
  <p class="cp-loading">Loading…</p>
</div>
<noscript><p>The carpool board needs JavaScript.</p></noscript>

<script is:inline>
(function () {
  var root = document.getElementById('cp');
  var DAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  var DIR = { to: 'To practice', from: 'From practice', both: 'Both ways' };
  var GROUPS = ['Splash', 'Tidepool', 'Riptide', 'Breakers', 'Surge', 'Senior'];
  var DRIVER = { parent: 'Parent driver', swimmer: 'Swimmer driver' };
  var me = null, tab = 'board', cache = {}, flash = '';

  function el(tag, attrs) {
    var n = document.createElement(tag);
    if (attrs) for (var k in attrs) {
      if (k === 'class') n.className = attrs[k];
      else if (k.slice(0, 2) === 'on') n.addEventListener(k.slice(2), attrs[k]);
      else if (attrs[k] !== false && attrs[k] != null) n.setAttribute(k, attrs[k]);
    }
    (function add(list) {
      for (var i = 0; i < list.length; i++) {
        var c = list[i];
        if (c == null || c === false) continue;
        if (Array.isArray(c)) add(c);
        else n.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);
      }
    })(Array.prototype.slice.call(arguments, 2));
    return n;
  }
  function api(method, path, body) {
    return fetch('/api/carpool' + path, {
      method: method, credentials: 'same-origin',
      headers: body ? { 'content-type': 'application/json' } : {},
      body: body ? JSON.stringify(body) : undefined,
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (d) {
        if (!r.ok) { var e = new Error(d.error || 'Something went wrong.'); e.status = r.status; throw e; }
        return d;
      });
    });
  }
  function msg(kind, text) { return text ? el('p', { class: 'cp-msg ' + kind, role: kind === 'err' ? 'alert' : 'status' }, text) : null; }
  function mount() { root.replaceChildren(); var h = el('div'); h.className = ''; root.replaceChildren.apply(root, Array.prototype.filter.call(arguments, function (x) { return x != null; })); }
  function when(p) { return p.days.join(' · ') + ' · ' + p.time; }
  function fmtDate(s) { return s ? s.slice(0, 10) : ''; }

  // ---------- signed out ----------
  function signedOut(note) {
    var form = el('form', { class: 'cp-form', onsubmit: function (e) {
      e.preventDefault();
      var f = e.target, out = f.querySelector('.cp-out');
      var d = { family: f.family.value, email: f.email.value, phone: f.phone.value, swimmers: f.swimmers.value, website: f.website.value };
      f.querySelector('button').disabled = true;
      api('POST', '/request-access', d).then(function () {
        mount(el('div', { class: 'cp-panel' }, el('h2', null, 'Request received'),
          el('p', null, 'Thank you. An admin will check the roster and send your personal sign-in link. It usually comes through Captyn or a text, so watch for it.')));
      }).catch(function (err) { out.replaceChildren(msg('err', err.message)); f.querySelector('button').disabled = false; });
    } },
      el('label', null, 'Family name', el('input', { name: 'family', required: true, maxlength: 60, autocomplete: 'family-name', placeholder: 'e.g. The Smiths' })),
      el('label', null, 'Email', el('input', { name: 'email', type: 'email', required: true, maxlength: 120, autocomplete: 'email' })),
      el('label', null, 'Mobile (optional)', el('input', { name: 'phone', type: 'tel', maxlength: 30, autocomplete: 'tel' })),
      el('label', null, 'Swimmer name(s) and group', el('input', { name: 'swimmers', required: true, maxlength: 160, placeholder: 'e.g. Alex (Surge)' })),
      el('div', { class: 'cp-hp', 'aria-hidden': 'true' }, el('label', null, 'Website', el('input', { name: 'website', tabindex: '-1', autocomplete: 'off' }))),
      el('div', { class: 'cp-out' }),
      el('button', { class: 'btn', type: 'submit' }, 'Request access'));
    mount(
      msg('err', note),
      el('div', { class: 'cp-panel' },
        el('h2', null, 'NSEA families only'),
        el('p', null, 'The carpool board helps current NSEA families share rides to practice. To keep it safe, every family is checked against our roster before getting access.'),
        el('p', null, el('strong', null, 'Already approved? '), 'Open the personal sign-in link an admin sent you. Each link works once; if it has expired, ask for a new one.')),
      el('div', { class: 'cp-panel' }, el('h3', null, 'Request access'),
        el('p', { class: 'cp-small' }, 'Your email and mobile are only shared with a family after both of you agree to connect.'), form));
  }

  // ---------- shell ----------
  function shell(content) {
    var tabs = [['board', 'Board'], ['post', 'Post a ride'], ['mine', 'My rides']];
    if (me.admin) tabs.push(['admin', 'Admin']);
    mount(
      el('div', { class: 'cp-top' },
        el('p', null, 'Signed in as ', el('strong', null, me.family)),
        el('button', { class: 'cp-link', type: 'button', onclick: function () { api('POST', '/logout', {}).then(function () { me = null; boot(); }); } }, 'Sign out')),
      el('div', { class: 'cp-safety' }, el('strong', null, 'Please note: '), 'Rides are arranged directly between families. NSEA does not screen drivers or vehicles and is not responsible for rides arranged here. Use your own judgment, follow ',
        el('a', { href: '/about/safe-sport/' }, 'Safe Sport'), ' guidance, and never put phone numbers or street addresses in a post. Swimmer drivers may offer rides only with their own parent’s or guardian’s agreement, and riders’ parents decide whether they are comfortable with a swimmer driver.'),
      el('div', { class: 'cp-tabs', role: 'tablist' }, tabs.map(function (t) {
        return el('button', { type: 'button', role: 'tab', 'aria-selected': tab === t[0] ? 'true' : 'false', onclick: function () { tab = t[0]; flash = ''; render(); } }, t[1]);
      })),
      msg('ok', flash), content);
  }
  function render() { ({ board: viewBoard, post: viewPost, mine: viewMine, admin: viewAdmin })[tab](); }

  // ---------- board ----------
  function viewBoard() {
    var filter = { kind: '', day: '', driver: '', group: '', dir: '', area: '' };
    var list = el('div', { class: 'cp-list' });
    function draw(posts) {
      var q = filter.area.toLowerCase();
      var shown = posts.filter(function (p) {
        return (!filter.kind || p.kind === filter.kind)
          && (!filter.day || p.days.indexOf(filter.day) >= 0)
          && (!filter.driver || p.driver === filter.driver)
          && (!filter.group || !p.groups.length || p.groups.indexOf(filter.group) >= 0)
          && (!filter.dir || p.direction === filter.dir || p.direction === 'both')
          && (!q || (p.area + ' ' + (p.note || '')).toLowerCase().indexOf(q) >= 0);
      });
      count.textContent = shown.length + ' of ' + posts.length + ' post' + (posts.length === 1 ? '' : 's');
      list.replaceChildren.apply(list, shown.length ? shown.map(postCard) : [el('p', { class: 'cp-empty' }, posts.length ? 'No posts match those filters.' : 'No rides posted yet. Be the first: use “Post a ride”.')]);
    }
    function postCard(p) {
      var action;
      if (p.mine) action = el('span', { class: 'cp-note' }, 'Your post' + (p.openRequests ? ' · ' + p.openRequests + ' request(s), see My rides' : ''));
      else if (p.myConnection === 'accepted') action = el('span', { class: 'cp-note ok' }, 'Connected: see My rides');
      else if (p.myConnection === 'requested') action = el('span', { class: 'cp-note' }, 'Request sent');
      else if (p.myConnection === 'declined') action = el('span', { class: 'cp-note' }, 'Not available');
      else action = el('button', { class: 'btn small', type: 'button', onclick: function (e) { connectBox(p, e.target.parentNode); } }, p.kind === 'offer' ? 'Ask for a seat' : 'Offer a ride');
      return el('article', { class: 'cp-card ' + p.kind },
        el('div', { class: 'cp-badge' }, p.kind === 'offer' ? 'Offering seats' : 'Needs a ride'),
        el('h3', null, p.family),
        p.driver ? el('p', null, el('span', { class: 'cp-tag ' + p.driver }, DRIVER[p.driver])) : null,
        p.swimmer ? el('p', { class: 'cp-swimmer' }, p.swimmer) : null,
        p.groups && p.groups.length ? el('p', { class: 'cp-small' }, 'Groups: ' + p.groups.join(', ')) : null,
        el('p', { class: 'cp-when' }, when(p)),
        el('p', null, DIR[p.direction] + ' · ' + p.area + ' · ' + p.seats + (p.kind === 'offer' ? ' seat(s)' : ' swimmer(s)')),
        p.cost ? el('p', null, 'Cost sharing: ' + p.cost) : null,
        p.note ? el('p', { class: 'cp-small' }, p.note) : null,
        el('div', { class: 'cp-act' }, action));
    }
    function connectBox(p, host) {
      var ta = el('textarea', { maxlength: 200, rows: 2, placeholder: 'Optional short note (no phone numbers or addresses)' });
      var out = el('div');
      host.replaceChildren(ta, out, el('button', { class: 'btn small', type: 'button', onclick: function () {
        api('POST', '/posts/' + p.id + '/connect', { message: ta.value }).then(function () {
          flash = 'Request sent to ' + p.family + '. If they accept, you will both see each other’s contact details under My rides.'; viewBoard();
        }).catch(function (e) { out.replaceChildren(msg('err', e.message)); });
      } }, 'Send request'));
    }
    function sel(key, label, opts) {
      return el('select', { 'aria-label': label, onchange: function (e) { filter[key] = e.target.value; draw(cache.posts); } },
        opts.map(function (o) { return el('option', { value: o[0] }, o[1]); }));
    }
    var count = el('p', { class: 'cp-small', 'aria-live': 'polite' });
    var area = el('input', { type: 'search', placeholder: 'Search area, e.g. Landfall', 'aria-label': 'Search area', oninput: function (e) { filter.area = e.target.value; draw(cache.posts); } });
    var bar = el('div', { class: 'cp-filters' },
      sel('kind', 'Type', [['', 'Offers and needs'], ['offer', 'Offers only'], ['need', 'Needs only']]),
      sel('driver', 'Driver', [['', 'Any driver'], ['parent', 'Parent drivers'], ['swimmer', 'Swimmer drivers']]),
      sel('group', 'Practice group', [['', 'Any group']].concat(GROUPS.map(function (g) { return [g, g]; }))),
      sel('day', 'Day', [['', 'Any day']].concat(DAYS.map(function (d) { return [d, d]; }))),
      sel('dir', 'Direction', [['', 'Any direction'], ['to', 'To practice'], ['from', 'From practice']]),
      area,
      el('button', { class: 'cp-link', type: 'button', onclick: function () { filter = { kind: '', day: '', driver: '', group: '', dir: '', area: '' }; viewBoard(); } }, 'Clear filters'));
    shell(el('div', null, bar, count, list));
    list.appendChild(el('p', { class: 'cp-empty' }, 'Loading…'));
    api('GET', '/posts').then(function (ps) { cache.posts = ps; draw(ps); }).catch(function (e) { list.replaceChildren(msg('err', e.message)); });
  }

  // ---------- post ----------
  function viewPost() {
    var form = el('form', { class: 'cp-form', onsubmit: function (e) {
      e.preventDefault();
      var f = e.target, out = f.querySelector('.cp-out');
      var days = DAYS.filter(function (d) { return f['d_' + d].checked; });
      var groups = GROUPS.filter(function (g) { return f['g_' + g].checked; });
      var d = { kind: f.kind.value, driver: f.kind.value === 'offer' ? (f.driver.value || '') : '', guardianOk: f.driver.value === 'swimmer' && f.guardianOk.checked, groups: groups, days: days, time: f.time.value, direction: f.direction.value, area: f.area.value, seats: f.seats.value, cost: f.cost.value, note: f.note.value, swimmer: f.swimmer.value };
      var another = e.submitter && e.submitter.getAttribute('data-another') === '1';
      api('POST', '/posts', d).then(function () {
        if (another) {
          // keep everything except the swimmer, direction and time, so a second leg is quick to add
          f.swimmer.value = ''; f.time.value = ''; f.direction.value = f.direction.value === 'to' ? 'from' : 'to'; f.swimmer.focus();
          out.replaceChildren(msg('ok', 'Posted. Add the next ride below (for example a different swimmer, or the ride home).'));
        } else { flash = 'Posted. It will stay on the board for 60 days or until you close it.'; tab = 'board'; render(); }
      }).catch(function (err) { out.replaceChildren(msg('err', err.message)); });
    } },
      el('fieldset', null, el('legend', null, 'I want to…'),
        el('label', { class: 'inline' }, el('input', { type: 'radio', name: 'kind', value: 'offer', checked: true }), ' offer seats'),
        el('label', { class: 'inline' }, el('input', { type: 'radio', name: 'kind', value: 'need' }), ' find a ride')),
      el('fieldset', { class: 'cp-driver' }, el('legend', null, 'Who would be driving?'),
        el('label', { class: 'inline' }, el('input', { type: 'radio', name: 'driver', value: 'parent', checked: true }), ' a parent'),
        el('label', { class: 'inline' }, el('input', { type: 'radio', name: 'driver', value: 'swimmer' }), ' a swimmer'),
        el('div', { class: 'cp-swimmer-rules' },
          el('p', { class: 'cp-small' }, el('strong', null, 'Swimmer drivers: '), 'A swimmer may offer rides only if they hold a valid driver’s license, the vehicle is legally insured and registered, and their own parent or guardian knows about and agrees to the arrangement. Swimmer drivers must follow all North Carolina license restrictions, including limits on passengers and driving hours for newer drivers. Riders’ parents should confirm directly with the driver’s family before a minor rides with a swimmer driver.'),
          el('label', { class: 'inline' }, el('input', { type: 'checkbox', name: 'guardianOk' }), ' My parent or guardian knows about and agrees to this, and I meet the requirements above.'))),
      el('fieldset', null, el('legend', null, 'Practice group(s) (optional)'), GROUPS.map(function (g) { return el('label', { class: 'inline' }, el('input', { type: 'checkbox', name: 'g_' + g }), ' ' + g); })),
      el('fieldset', null, el('legend', null, 'Days'), DAYS.map(function (d) { return el('label', { class: 'inline' }, el('input', { type: 'checkbox', name: 'd_' + d }), ' ' + d); })),
      el('label', null, 'Which swimmer or group? (optional)', el('input', { name: 'swimmer', maxlength: 60, placeholder: 'e.g. Alex, Surge group' })),
      el('label', null, 'Time', el('input', { name: 'time', required: true, maxlength: 60, placeholder: 'e.g. Leave 4:15 pm, practice 5:00 pm' })),
      el('label', null, 'Direction', el('select', { name: 'direction' }, el('option', { value: 'to' }, 'To practice'), el('option', { value: 'from' }, 'From practice'), el('option', { value: 'both' }, 'Both ways'))),
      el('label', null, 'General area', el('input', { name: 'area', required: true, maxlength: 60, placeholder: 'Neighborhood or part of town, not a street address' })),
      el('label', null, 'Seats offered / swimmers needing a ride', el('input', { name: 'seats', type: 'number', min: 1, max: 8, value: 1 })),
      el('label', null, 'Cost sharing (optional)', el('input', { name: 'cost', maxlength: 80, placeholder: 'e.g. Gas split, or free' })),
      el('label', null, 'Note (optional)', el('input', { name: 'note', maxlength: 200, placeholder: 'No phone numbers or addresses' })),
      el('div', { class: 'cp-out' }),
      el('div', { class: 'cp-btns' }, el('button', { class: 'btn', type: 'submit' }, 'Post to the board'), el('button', { class: 'btn ghost', type: 'submit', 'data-another': '1' }, 'Post and add another')));
    function syncDriver() { form.querySelector('.cp-driver').style.display = form.kind.value === 'offer' ? '' : 'none'; form.querySelector('.cp-swimmer-rules').style.display = form.kind.value === 'offer' && form.driver.value === 'swimmer' ? '' : 'none'; }
    form.addEventListener('change', function (e) { if (e.target.name === 'kind' || e.target.name === 'driver') syncDriver(); });
    syncDriver();
    shell(el('div', { class: 'cp-panel' }, el('h2', null, 'Post a ride'),
      el('p', { class: 'cp-small' }, 'Other families see your family name, the days and times, and the general area. Your email and phone stay private until you accept a request.'),
      el('p', { class: 'cp-small' }, 'Swimmers with different needs? Post each ride separately, for example one post for a ride to practice and another for a ride home, or a separate post for each swimmer. Use “Post and add another” to do it quickly.'), form));
  }

  // ---------- my rides ----------
  function viewMine() {
    var box = el('div', null, el('p', { class: 'cp-empty' }, 'Loading…'));
    shell(box);
    Promise.all([api('GET', '/connections'), api('GET', '/posts')]).then(function (r) {
      var conns = r[0], mine = r[1].filter(function (p) { return p.mine; });
      function act(label, path, cls) { return el('button', { class: 'btn small ' + (cls || ''), type: 'button', onclick: function () {
        api('POST', path, {}).then(function () { viewMine(); }).catch(function (e) { alert(e.message); }); } }, label); }
      function line(c) { return (c.post.driver ? DRIVER[c.post.driver] + ' · ' : '') + (c.post.swimmer ? c.post.swimmer + ' · ' : '') + c.post.days.join(' · ') + ' · ' + c.post.time + ' · ' + DIR[c.post.direction] + ' · ' + c.post.area; }
      var incoming = conns.filter(function (c) { return c.role === 'poster' && c.status === 'requested'; });
      var outgoing = conns.filter(function (c) { return c.role === 'requester' && c.status === 'requested'; });
      var connected = conns.filter(function (c) { return c.status === 'accepted'; });
      var phone = el('form', { class: 'cp-inline', onsubmit: function (e) {
        e.preventDefault(); api('POST', '/me', { phone: e.target.phone.value }).then(function () { me.phone = e.target.phone.value; flash = 'Phone saved.'; viewMine(); });
      } }, el('label', null, 'Your mobile (shared only with families you connect with)', el('input', { name: 'phone', type: 'tel', maxlength: 30, value: me.phone || '' })), el('button', { class: 'btn small', type: 'submit' }, 'Save'));
      box.replaceChildren(
        el('div', { class: 'cp-panel' }, el('h3', null, 'Requests for your posts'),
          incoming.length ? incoming.map(function (c) { return el('div', { class: 'cp-row' }, el('div', null, el('strong', null, c.other.family), ' · ' + line(c), c.message ? el('p', { class: 'cp-small' }, '“' + c.message + '”') : null),
            el('div', { class: 'cp-btns' }, act('Accept', '/connections/' + c.id + '/accept'), act('Decline', '/connections/' + c.id + '/decline', 'ghost'))); }) : el('p', { class: 'cp-empty' }, 'No new requests.')),
        el('div', { class: 'cp-panel' }, el('h3', null, 'Connected'),
          el('p', { class: 'cp-small' }, 'You can now contact each other directly to work out the details.'),
          connected.length ? connected.map(function (c) { return el('div', { class: 'cp-row' }, el('div', null, el('strong', null, c.other.family), ' · ' + line(c),
            el('p', null, el('a', { href: 'mailto:' + c.other.email }, c.other.email), c.other.phone ? [' · ', el('a', { href: 'tel:' + c.other.phone }, c.other.phone)] : null)),
            el('div', { class: 'cp-btns' }, act('End', '/connections/' + c.id + '/cancel', 'ghost'))); }) : el('p', { class: 'cp-empty' }, 'No connections yet.')),
        el('div', { class: 'cp-panel' }, el('h3', null, 'Requests you sent'),
          outgoing.length ? outgoing.map(function (c) { return el('div', { class: 'cp-row' }, el('div', null, el('strong', null, c.other.family), ' · ' + line(c), el('p', { class: 'cp-small' }, 'Waiting for a reply')),
            el('div', { class: 'cp-btns' }, act('Cancel', '/connections/' + c.id + '/cancel', 'ghost'))); }) : el('p', { class: 'cp-empty' }, 'Nothing pending.')),
        el('div', { class: 'cp-panel' }, el('h3', null, 'Your posts'),
          mine.length ? mine.map(function (p) { return el('div', { class: 'cp-row' }, el('div', null, el('strong', null, p.kind === 'offer' ? 'Offering' : 'Needing'), ' · ' + (p.driver ? DRIVER[p.driver] + ' · ' : '') + (p.swimmer ? p.swimmer + ' · ' : '') + when(p) + ' · ' + DIR[p.direction] + ' · ' + p.area),
            el('div', { class: 'cp-btns' }, act('Close post', '/posts/' + p.id + '/close', 'ghost'))); }) : el('p', { class: 'cp-empty' }, 'You have no open posts.')),
        el('div', { class: 'cp-panel' }, phone));
    }).catch(function (e) { box.replaceChildren(msg('err', e.message)); });
  }

  // ---------- admin ----------
  function viewAdmin() {
    var box = el('div', null, el('p', { class: 'cp-empty' }, 'Loading…'));
    shell(box);
    api('GET', '/admin/overview').then(function (o) {
      var linkOut = el('div');
      function show(name, link) {
        var inp = el('input', { readonly: true, value: link, 'aria-label': 'Sign-in link', onfocus: function (e) { e.target.select(); } });
        linkOut.replaceChildren(el('div', { class: 'cp-panel cp-link-box' }, el('strong', null, 'Sign-in link for ' + name + ' (works once, valid 14 days):'), inp,
          el('button', { class: 'btn small', type: 'button', onclick: function () { inp.select(); navigator.clipboard && navigator.clipboard.writeText(link); } }, 'Copy'),
          el('p', { class: 'cp-small' }, 'Send it to them privately (Captyn message or text). This is the only time it is shown.')));
        linkOut.scrollIntoView({ block: 'nearest' });
      }
      function act(label, path, cls, after) { return el('button', { class: 'btn small ' + (cls || ''), type: 'button', onclick: function () {
        api('POST', path, {}).then(function (r) { if (r.link) show(after, r.link); else viewAdmin(); if (r.link) { /* keep link visible; refresh list quietly */ api('GET', '/admin/overview').then(function (n) { drawLists(n); }); } })
          .catch(function (e) { alert(e.message); }); } }, label); }
      var lists = el('div');
      function drawLists(o) {
        var pending = o.members.filter(function (m) { return m.status === 'pending'; });
        var others = o.members.filter(function (m) { return m.status !== 'pending'; });
        lists.replaceChildren(
          el('div', { class: 'cp-panel' }, el('h3', null, 'Waiting for approval (' + pending.length + ')'),
            el('p', { class: 'cp-small' }, 'Check each family against the roster before approving.'),
            pending.length ? pending.map(function (m) { return el('div', { class: 'cp-row' }, el('div', null, el('strong', null, m.family_name), ' · ' + m.swimmers, el('p', { class: 'cp-small' }, m.email + (m.phone ? ' · ' + m.phone : '') + ' · requested ' + fmtDate(m.created_at))),
              el('div', { class: 'cp-btns' }, act('Approve', '/admin/members/' + m.id + '/approve', '', m.family_name), act('Reject', '/admin/members/' + m.id + '/reject', 'ghost'))); }) : el('p', { class: 'cp-empty' }, 'No requests waiting.')),
          el('div', { class: 'cp-panel' }, el('h3', null, 'Members (' + others.length + ')'),
            others.map(function (m) { return el('div', { class: 'cp-row' }, el('div', null, el('strong', null, m.family_name), m.is_admin ? ' (admin)' : '', m.status === 'disabled' ? ' (disabled)' : '', ' · ' + m.swimmers, el('p', { class: 'cp-small' }, m.email)),
              el('div', { class: 'cp-btns' },
                m.status === 'active' ? act('New link', '/admin/members/' + m.id + '/link', '', m.family_name) : null,
                m.status === 'active' ? act(m.is_admin ? 'Remove admin' : 'Make admin', '/admin/members/' + m.id + (m.is_admin ? '/demote' : '/promote'), 'ghost') : null,
                m.id !== me.id ? act(m.status === 'disabled' ? 'Re-enable' : 'Disable', '/admin/members/' + m.id + (m.status === 'disabled' ? '/enable' : '/disable'), 'ghost') : null)); })),
          el('div', { class: 'cp-panel' }, el('h3', null, 'All posts (' + o.posts.filter(function (p) { return p.status === 'open'; }).length + ' open)'),
            o.posts.slice(0, 60).map(function (p) { return el('div', { class: 'cp-row' }, el('div', null, el('strong', null, p.family_name), ' · ' + (p.kind === 'offer' ? 'offers' + (p.driver ? ' (' + p.driver + ' driver)' : '') : 'needs') + (p.groups ? ' · ' + p.groups.split(',').join('/') : '') + ' · ' + p.days.split(',').join(' · ') + ' · ' + p.time_label + ' · ' + p.area, el('p', { class: 'cp-small' }, p.status + ' · posted ' + fmtDate(p.created_at))),
              el('div', { class: 'cp-btns' }, p.status === 'open' ? act('Close', '/posts/' + p.id + '/close', 'ghost') : null)); })),
          el('div', { class: 'cp-panel' }, el('h3', null, 'Recent connections'),
            o.connections.length ? o.connections.slice(0, 50).map(function (c) { return el('p', { class: 'cp-small' }, c.requester + ' → ' + c.poster + ' (' + c.kind + ', ' + c.area + ') · ' + c.status + ' · ' + fmtDate(c.updated_at)); }) : el('p', { class: 'cp-empty' }, 'None yet.')));
      }
      drawLists(o);
      box.replaceChildren(linkOut, lists);
    }).catch(function (e) { box.replaceChildren(msg('err', e.message)); });
  }

  // ---------- boot ----------
  function boot() {
    var k = new URLSearchParams(location.search).get('k');
    var start = k ? api('POST', '/session', { token: k }).then(function () { history.replaceState(null, '', location.pathname); return null; })
      .catch(function (e) { history.replaceState(null, '', location.pathname); return e.message; }) : Promise.resolve(null);
    start.then(function (err) {
      api('GET', '/me').then(function (m) { me = m; tab = 'board'; }, function () { me = null; })
        .then(function () { if (me) render(); else signedOut(err); });
    });
  }
  boot();
})();
</script>
